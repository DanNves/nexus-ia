# Ignore global do monorepo NEXUS.
# Regras específicas ficam em frontend/.gitignore e backend/.gitignore.

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Editores
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# Variáveis de ambiente / segredos
.env
.env.*
!.env.example

# Logs
*.log

# Claude Code — agentes, configurações locais e memórias do time (não versionar)
.claude/
claude/
