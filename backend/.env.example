# Modelo do arquivo backend/.env (copie para .env e ajuste). Nunca versione o .env real.
# Variáveis lidas em config/settings/base.py.

# ---------- Django ----------
# Gere uma chave nova: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
# True só em desenvolvimento local. Com False o cookie do refresh exige HTTPS (Secure).
DJANGO_DEBUG=True
# Hosts aceitos, separados por vírgula.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Arquivo SQLite, relativo à pasta backend/.
DJANGO_DB_NOME=db.sqlite3
# Origens do navegador aceitas nas rotas /api/v1/auth/* (proteção contra CSRF), separadas por vírgula.
AUTH_ORIGENS_PERMITIDAS=http://localhost:4200,http://127.0.0.1:4200

# ---------- Limites da API ----------
# Tentativas de registro/entrar por IP (proteção contra força bruta).
API_LIMITE_AUTH=10/min
# Renovações de sessão por IP (o Angular renova a cada carregamento de página).
API_LIMITE_RENOVAR=60/min
# Pedidos de geração à IA por usuário.
IA_LIMITE_POR_USUARIO=10/min

# ---------- IA (CLAUDE.md §19) ----------
# Provedor ativo: gemini | openai_compat | fake  (fake = sem internet, padrão para demonstração).
# Registro dos provedores em apps/ia/adapters/__init__.py (novo provedor = 1 arquivo + 1 linha).
IA_PROVEDOR=fake
# Modelo principal. Com gemini, recomendado (2026-10-15, ver claude/ia.md): gemini-3.5-flash-lite.
IA_MODELO=gemini-3.5-flash-lite
# Modelos de reserva, tentados em ordem se o principal der 503/429/404/timeout (vazio = nenhum).
# Com gemini, recomendado (medido em 2026-10-15, ver claude/ia.md): gemini-3.8-flash,gemini-3.6-flash
IA_MODELOS_RESERVA=gemini-3.8-flash,gemini-3.6-flash
IA_TEMPERATURA=0.3
# Tempo máximo por tentativa; estourou, passa para a reserva (free tier varia de 2 a 40 s).
IA_TIMEOUT_SEGUNDOS=20
# Gerações permitidas por registro-alvo (demanda/chamado).
IA_COTA_POR_ALVO=20
# Jobs de IA executando ao mesmo tempo.
IA_MAX_SIMULTANEOS=2
# True executa o job dentro da requisição (útil para depurar).
IA_EXECUCAO_SINCRONA=False

# Gemini (deixe a chave vazia se não usar).
GEMINI_API_KEY=
GEMINI_URL_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_NIVEL_RACIOCINIO=low

# Provedor compatível com a API da OpenAI (deixe a chave vazia se não usar).
OPENAI_COMPAT_URL_BASE=https://api.openai.com/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_FORMATO=json_schema
